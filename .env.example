# WARNING: The following settings are for development environments only.
# Make sure to change the password in production.
PASSPORT_DB_USERNAME=
PASSPORT_DB_PASSWORD=
PASSPORT_DB_HOST=localhost
PASSPORT_DB_PORT=5432

PASSPORT_DB_OWNERNAME=
PASSPORT_DB_OWNER_PASSWORD=

# Valkey - authentication transactions and login rate limits
PASSPORT_AUTH_REDIS_HOST=localhost
PASSPORT_AUTH_REDIS_PORT=6379
PASSPORT_AUTH_REDIS_DB=1
PASSPORT_AUTH_REDIS_PASSWORD=

# JWT signing key for LOCAL authentication (RS256).
# Preferred: path to a PEM file kept off the environment (chmod 600 / mounted secret).
PASSPORT_JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
# Optional fallback for platforms that can only inject secrets as env vars
# (inline PEM, newlines escaped as \n). Leave unset when using the path above.
# PASSPORT_JWT_PRIVATE_KEY=

# Valkey - shared query cache
PASSPORT_CACHE_REDIS_HOST=localhost
PASSPORT_CACHE_REDIS_PORT=6379
PASSPORT_CACHE_REDIS_DB=2
PASSPORT_CACHE_REDIS_USERNAME=
PASSPORT_CACHE_REDIS_PASSWORD=
PASSPORT_CACHE_REDIS_SSL=false
PASSPORT_CACHE_REDIS_SSL_CA_CERTS=
PASSPORT_CACHE_REDIS_SSL_CERTFILE=
PASSPORT_CACHE_REDIS_SSL_KEYFILE=
PASSPORT_CACHE_REDIS_UNIX_SOCKET_PATH=

# Valkey - Celery broker
PASSPORT_CELERY_BROKER_URL=redis://localhost:6379/3

# UID of the search key (not a secret). The API signs a per-request tenant token
# with the search key and this UID. The default is the fixed UID keys.sh issues.
# PASSPORT_SEARCH_MEILI_SEARCH_KEY_UID=7f0c6a52-6b1e-4c1f-9a53-3a1f3f4f8e01

# Activity-log broker connection (endpoint + credentials).
# Only required when activity.messaging.backend is an external broker
# (redis / rabbitmq / kafka); the default in_process backend needs none. The
# logical names (stream/exchange/topic/consumer_group) live in config.json;
# everything needed to *connect* is here. Defaults shown; uncomment to override.
# --- Redis (Streams) ---
# PASSPORT_ACTIVITY_REDIS_HOST=localhost
# PASSPORT_ACTIVITY_REDIS_PORT=6379
# PASSPORT_ACTIVITY_REDIS_DB=0
# PASSPORT_ACTIVITY_REDIS_PASSWORD=
# --- RabbitMQ ---
# PASSPORT_ACTIVITY_RABBITMQ_HOST=localhost
# PASSPORT_ACTIVITY_RABBITMQ_PORT=5672
# PASSPORT_ACTIVITY_RABBITMQ_VHOST=/
# PASSPORT_ACTIVITY_RABBITMQ_USERNAME=
# PASSPORT_ACTIVITY_RABBITMQ_PASSWORD=
# --- Kafka ---
# PASSPORT_ACTIVITY_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# PASSPORT_ACTIVITY_KAFKA_SASL_USERNAME=
# PASSPORT_ACTIVITY_KAFKA_SASL_PASSWORD=
